		<dc:title id="title">The Sorrows of Young Werther</dc:title>
		<meta property="file-as" refines="#title">Sorrows of Young Werther, The</meta>
		<dc:subject id="subject-1">Germany--Social life and customs--Fiction</dc:subject>
		<dc:subject id="subject-2">Unrequited love--Fiction</dc:subject>
